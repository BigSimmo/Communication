{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "preinstall": "node ./scripts/require-pnpm.mjs",
    "run": "node ./scripts/local-app.mjs run",
    "app:run": "node ./scripts/local-app.mjs run",
    "app:guard": "node ./scripts/local-app.mjs guard",
    "app:stop": "node ./scripts/local-app.mjs stop",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "code-review": "node scripts/code-reviewer.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
