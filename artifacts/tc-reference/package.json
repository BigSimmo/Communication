{
  "name": "@workspace/tc-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:downloads": "node ../../scripts/ensure-card-downloads.mjs",
    "dev": "pnpm run generate:downloads && vite --config vite.config.ts --host 127.0.0.1",
    "build": "pnpm run generate:downloads && vite build --config vite.config.ts && pnpm --filter @workspace/scripts exec tsx ../artifacts/tc-reference/scripts/verify-card-build.ts",
    "serve": "vite preview --config vite.config.ts --host 127.0.0.1",
    "start": "node server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/ensure-downloads.mjs && vitest run --config vitest.config.ts",
    "test:full": "pnpm run generate:downloads && vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^30.1.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "wouter": "^3.13.0"
  },
  "dependencies": {
    "sirv": "^3.0.2"
  }
}
